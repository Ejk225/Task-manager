# Copie ce fichier en ".env" (racine du projet) pour docker-compose.
# Ne commite jamais le fichier ".env" réel (il est ignoré par .gitignore).

# --- Base de données PostgreSQL ---
DB_NAME=task_manager_db
DB_USER=postgres
DB_PASSWORD=change_me_en_local

# --- Backend ---
# Générer une valeur forte, par ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_avec_une_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost
